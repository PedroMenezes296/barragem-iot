{
  "openapi": "3.0.0",
  "paths": {
    "/": {
      "get": {
        "operationId": "AppController_getHello",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Mensagem padrão da aplicação.",
            "content": {
              "text/html": {
                "schema": {
                  "type": "string",
                  "example": "Hello World!"
                }
              }
            }
          }
        },
        "summary": "Consultar a mensagem inicial da aplicação",
        "tags": [
          "Aplicação"
        ]
      }
    },
    "/leituras": {
      "post": {
        "description": "Valida o JSON V1 e persiste os campos no MongoDB. Campos desconhecidos são rejeitados. Atualmente os quatro campos de medição são opcionais individualmente, sem exigir ao menos um deles. Não há confirmação idempotente para reenvios duplicados.",
        "operationId": "LeiturasController_create",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateLeituraDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Leitura armazenada com sucesso.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateLeituraResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "JSON inválido, campo obrigatório ausente, valor inválido ou propriedade desconhecida.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "statusCode",
                    "message",
                    "error"
                  ],
                  "properties": {
                    "statusCode": {
                      "type": "integer",
                      "example": 400
                    },
                    "message": {
                      "oneOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        }
                      ],
                      "example": [
                        "versao must be equal to 1"
                      ]
                    },
                    "error": {
                      "type": "string",
                      "example": "Bad Request"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Erro não tratado de persistência/consulta. Duplicidades também não possuem tratamento específico e resultam em erro interno.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "statusCode",
                    "message"
                  ],
                  "properties": {
                    "statusCode": {
                      "type": "integer",
                      "example": 500
                    },
                    "message": {
                      "type": "string",
                      "example": "Internal server error"
                    }
                  }
                }
              }
            }
          }
        },
        "summary": "Receber e armazenar uma leitura dos sensores",
        "tags": [
          "Leituras"
        ]
      },
      "get": {
        "description": "Retorna as leituras em ordem decrescente de recebidoEm. Não há filtros, parâmetros de consulta ou paginação implementados.",
        "operationId": "LeiturasController_findAll",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Lista de leituras, vazia quando não há registros.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/LeituraResponseDto"
                  }
                }
              }
            }
          },
          "500": {
            "description": "Erro não tratado de persistência/consulta. Duplicidades também não possuem tratamento específico e resultam em erro interno.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "statusCode",
                    "message"
                  ],
                  "properties": {
                    "statusCode": {
                      "type": "integer",
                      "example": 500
                    },
                    "message": {
                      "type": "string",
                      "example": "Internal server error"
                    }
                  }
                }
              }
            }
          }
        },
        "summary": "Consultar todas as leituras armazenadas",
        "tags": [
          "Leituras"
        ]
      }
    },
    "/alertas/configuracao": {
      "get": {
        "operationId": "AlertasController_getConfig",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AlarmConfigDto"
                }
              }
            }
          }
        },
        "summary": "Consultar limites persistidos dos alarmes da maquete",
        "tags": [
          "Alertas"
        ]
      },
      "put": {
        "operationId": "AlertasController_update",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateAlarmConfigDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AlarmConfigDto"
                }
              }
            }
          },
          "400": {
            "description": "Limites ou dispositivo inválidos."
          }
        },
        "summary": "Salvar referência e limites; exige seca < atenção < inundação <= distanciaFundoCm - 2",
        "tags": [
          "Alertas"
        ]
      }
    },
    "/alertas/estado": {
      "get": {
        "operationId": "AlertasController_getStatus",
        "parameters": [
          {
            "name": "idDispositivo",
            "required": false,
            "in": "query",
            "description": "Dispositivo solicitante. Outro dispositivo recebe estado desativado.",
            "schema": {
              "example": "arduino-mega-01",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AlarmStatusDto"
                }
              }
            }
          }
        },
        "summary": "Avaliar a última leitura recebida do dispositivo configurado; expira após 30 segundos",
        "tags": [
          "Alertas"
        ]
      }
    }
  },
  "info": {
    "title": "BarragemIoT API",
    "description": "API de recebimento e consulta de leituras dos sensores de monitoramento de barragens. Documenta o comportamento atualmente implementado.",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "CreateLeituraDto": {
        "type": "object",
        "properties": {
          "versao": {
            "type": "integer",
            "enum": [
              1
            ],
            "description": "Versão do contrato JSON, atualmente igual a 1.",
            "example": 1
          },
          "idDispositivo": {
            "type": "string",
            "minLength": 1,
            "description": "Identificador estável do Arduino.",
            "example": "arduino-mega-01"
          },
          "idLeitura": {
            "type": "string",
            "minLength": 1,
            "description": "Identificador da medição, preservado em reenvios. A combinação com idDispositivo é única no banco.",
            "example": "arduino-mega-01-20261022T160000-001"
          },
          "timestampRtc": {
            "type": "string",
            "format": "date-time",
            "pattern": "(Z|[+-]\\d{2}:\\d{2})$",
            "description": "Data e hora da medição no RTC em ISO 8601 com fuso obrigatório.",
            "example": "2026-10-22T16:00:00-03:00"
          },
          "distanciaCm": {
            "type": "number",
            "minimum": 0,
            "nullable": true,
            "description": "Distância do HC-SR04 à superfície da água, em cm; entrada do cálculo no backend (referência - distância). Faixa mensurável: 2 a 400 cm e até a referência. Fora dela, nível salvo como null. Omitir quando indisponível; também aceita null.",
            "example": 35.7
          },
          "nivelUltrassonicoCm": {
            "type": "number",
            "deprecated": true,
            "minimum": 0,
            "nullable": true,
            "description": "Legado: aceito temporariamente para compatibilidade, mas ignorado. O backend calcula o nível exclusivamente pela distância e referência configurada.",
            "example": 14.3
          },
          "nivelResistivoCm": {
            "type": "number",
            "minimum": 0,
            "nullable": true,
            "description": "Nível da água em cm dentro da faixa calibrada do sensor resistivo. Omitir sem calibração; o validador atual também aceita null.",
            "example": 3.2
          },
          "umidadePct": {
            "type": "number",
            "minimum": 0,
            "maximum": 100,
            "nullable": true,
            "description": "Umidade relativa do ar em porcentagem. Omitir quando indisponível; o validador atual também aceita null.",
            "example": 65
          }
        },
        "required": [
          "versao",
          "idDispositivo",
          "idLeitura",
          "timestampRtc"
        ]
      },
      "LeituraResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "ObjectId do MongoDB exposto pelo Prisma como id.",
            "example": "507f1f77bcf86cd799439011"
          },
          "versao": {
            "type": "integer",
            "description": "Versão do contrato armazenada.",
            "example": 1
          },
          "idDispositivo": {
            "type": "string",
            "description": "Identificador do dispositivo.",
            "example": "arduino-mega-01"
          },
          "idLeitura": {
            "type": "string",
            "description": "Identificador da medição.",
            "example": "arduino-mega-01-20261022T160000-001"
          },
          "timestampRtc": {
            "type": "string",
            "description": "Horário da medição armazenado como texto ISO 8601 com fuso.",
            "example": "2026-10-22T16:00:00-03:00"
          },
          "distanciaCm": {
            "type": "number",
            "nullable": true,
            "description": "Distância sensor–água em cm; null quando ausente.",
            "example": 35.7
          },
          "nivelUltrassonicoCm": {
            "type": "number",
            "nullable": true,
            "description": "Nível em cm calculado pelo backend (distanciaFundoCm - distanciaCm); null sem referência válida para o dispositivo ou distância mensurável. Zero é válido.",
            "example": 14.3
          },
          "nivelResistivoCm": {
            "type": "number",
            "nullable": true,
            "description": "Nível resistivo em cm; null quando ausente.",
            "example": 3.2
          },
          "umidadePct": {
            "type": "number",
            "nullable": true,
            "description": "Umidade relativa em porcentagem; null quando ausente.",
            "example": 65
          },
          "recebidoEm": {
            "type": "string",
            "format": "date-time",
            "description": "Horário de recebimento gerado pelo banco, serializado em UTC.",
            "example": "2026-10-22T19:00:01.000Z"
          }
        },
        "required": [
          "id",
          "versao",
          "idDispositivo",
          "idLeitura",
          "timestampRtc",
          "distanciaCm",
          "nivelUltrassonicoCm",
          "nivelResistivoCm",
          "umidadePct",
          "recebidoEm"
        ]
      },
      "CreateLeituraResponseDto": {
        "type": "object",
        "properties": {
          "mensagem": {
            "type": "string",
            "description": "Confirmação de armazenamento.",
            "example": "Leitura armazenada com sucesso!"
          },
          "leitura": {
            "description": "Leitura persistida no MongoDB.",
            "allOf": [
              {
                "$ref": "#/components/schemas/LeituraResponseDto"
              }
            ]
          }
        },
        "required": [
          "mensagem",
          "leitura"
        ]
      },
      "AlarmConfigDto": {
        "type": "object",
        "properties": {
          "idDispositivo": {
            "type": "string"
          },
          "ativo": {
            "type": "boolean"
          },
          "distanciaFundoCm": {
            "type": "number",
            "nullable": true
          },
          "secaCm": {
            "type": "number",
            "nullable": true
          },
          "atencaoCm": {
            "type": "number",
            "nullable": true
          },
          "inundacaoCm": {
            "type": "number",
            "nullable": true
          },
          "atualizadoEm": {
            "type": "string",
            "nullable": true,
            "format": "date-time"
          },
          "nivelMaximoConfiguravelCm": {
            "type": "number",
            "nullable": true,
            "example": 3.75,
            "description": "distanciaFundoCm - 2; null sem referência configurada."
          }
        },
        "required": [
          "idDispositivo",
          "ativo",
          "distanciaFundoCm",
          "secaCm",
          "atencaoCm",
          "inundacaoCm",
          "atualizadoEm",
          "nivelMaximoConfiguravelCm"
        ]
      },
      "UpdateAlarmConfigDto": {
        "type": "object",
        "properties": {
          "idDispositivo": {
            "type": "string",
            "example": "arduino-mega-01"
          },
          "ativo": {
            "type": "boolean",
            "example": false
          },
          "distanciaFundoCm": {
            "type": "number",
            "minimum": 2,
            "maximum": 400,
            "exclusiveMinimum": true,
            "example": 5.75,
            "description": "Distância sensor–fundo com reservatório vazio. O máximo mensurável é esta referência menos 2 cm."
          },
          "secaCm": {
            "type": "number",
            "minimum": 0,
            "description": "Altura da água; alarme quando nível <= secaCm. Máximo: distanciaFundoCm - 2."
          },
          "atencaoCm": {
            "type": "number",
            "minimum": 0,
            "description": "Altura da água; atenção quando nível >= atencaoCm e < inundacaoCm. Máximo: distanciaFundoCm - 2."
          },
          "inundacaoCm": {
            "type": "number",
            "minimum": 0,
            "description": "Altura da água; alarme quando nível >= inundacaoCm. Máximo: distanciaFundoCm - 2."
          }
        },
        "required": [
          "idDispositivo",
          "ativo",
          "distanciaFundoCm",
          "secaCm",
          "atencaoCm",
          "inundacaoCm"
        ]
      },
      "AlarmStatusDto": {
        "type": "object",
        "properties": {
          "idDispositivo": {
            "type": "string",
            "description": "Dispositivo ao qual este comando se aplica."
          },
          "estado": {
            "type": "string",
            "enum": [
              "desativado",
              "sem_dados",
              "desatualizado",
              "normal",
              "seca",
              "atencao",
              "inundacao"
            ]
          },
          "alarmeAtivo": {
            "type": "boolean"
          },
          "nivelCm": {
            "type": "number",
            "nullable": true
          },
          "percentualNivelPct": {
            "type": "number",
            "nullable": true,
            "description": "Percentual da altura: nivelCm / inundacaoCm * 100, sem limitar a 100%. Não representa volume nem confirmação do alarme físico."
          },
          "idLeitura": {
            "type": "string",
            "nullable": true
          },
          "recebidoEm": {
            "type": "string",
            "nullable": true,
            "format": "date-time"
          }
        },
        "required": [
          "idDispositivo",
          "estado",
          "alarmeAtivo",
          "nivelCm",
          "percentualNivelPct",
          "idLeitura",
          "recebidoEm"
        ]
      }
    }
  }
}
