generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Leitura {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  versao        Int
  idDispositivo String
  idLeitura     String
  timestampRtc  String

  distanciaCm         Float?
  nivelUltrassonicoCm Float?
  nivelResistivoCm    Float?
  umidadePct          Float?

  recebidoEm DateTime @default(now())

  @@unique([idDispositivo, idLeitura])
  @@index([recebidoEm])
  @@map("leituras")
}
